# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# URL of the Express API
NEXT_PUBLIC_API_URL=http://localhost:5000

# imgbb API key for image uploads (https://api.imgbb.com)
NEXT_PUBLIC_IMGBB_API_KEY=

# MongoDB Atlas connection string (same database as the server)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rentrig

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Must be exactly the same value as JWT_SECRET on the server
JWT_SECRET=replace-with-a-long-random-string

# Google login (Google Cloud Console -> OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The account that registers with this email becomes the admin
ADMIN_EMAIL=admin@rentrig.com
